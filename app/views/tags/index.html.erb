<% content_for(:title, t(".page_title")) %>
<% breadcrumb :tag_index %>

<div class="container">
  <div class="row">
    <h3><%= t(".please_select_tag") %></h3>

    <%= form_with url: searchs_path, method: :get do %>
      <h3><%= t(".area") %></h3>
      <%= render "tag_list", tags: @area_tags, tag_type: "area_tags" %>

      <h3><%= t(".genre") %></h3>
      <%= render "tag_list", tags: @genre_tags, tag_type: "genre_tags" %>

      <h3><%= t(".taste") %></h3>
      <%= render "tag_list", tags: @taste_tags, tag_type: "taste_tags" %>

      <h3><%= t(".outher") %></h3>
      <%= render "tag_list", tags: @outher_tags, tag_type: "outher_tags" %>

      <%= submit_tag t("helpers.submit.decision") %>
    <% end %>
  </div>
</div>