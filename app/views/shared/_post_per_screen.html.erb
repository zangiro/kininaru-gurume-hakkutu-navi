<%# 画面XXL %>
<div class="col-2 mb-1 d-none d-xxl-block">
  <% case search_methods %>
  <% when "search_form" %>
    <%= render "post_image_for_search_form", post: post %>
  <% when "tag_index" %>
    <%= render "post_image_for_index", post: post %>
  <% when "post_index" %>
    <%= render "post_image", post: post %>
    <%= render "post_image_header", post: post %>
  <% else %>
    <%= render "post_image", post: post %>
  <% end %>
</div>

