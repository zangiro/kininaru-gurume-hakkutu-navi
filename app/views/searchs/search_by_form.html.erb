<% content_for(:title, t(".page_title")) %>
<% breadcrumb :search_by_form, @word %>

<div class="container">
  <div class="row">
    <% if @posts.present? %>
      <h3><%= t(".search_results") %></h3>

      <% @posts.each do |post| %>
        <%= render "post_per_screen", post: post, search_methods: "search_form" %>
      <% end %>

      <%= paginate @posts, theme: "bootstrap-5" %>

      <% if @recommendations.present? %>
        <div class='row'>
          <div>
            <hr class="my-4">

            <h6><%= t(".everyone_view_histories") %></h6>
          </div>

          <%# おすすめを表示 %>
          <% @recommendations.each do |post| %>
            <%= render "post_per_screen", post: post, search_methods: "search_form" %>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <h3><%= t(".target_not_found") %></h3>

      <div class='row'>
        <div>
          <hr class="my-4">

          <h6><%= t(".everyone_view_histories") %></h6>
        </div>

        <%# おすすめを表示 %>
        <% @recommendations.each do |post| %>
          <%= render "post_per_screen", post: post, search_methods: "search_form" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>